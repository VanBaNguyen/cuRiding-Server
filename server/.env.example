# Server host and port
HOST=0.0.0.0
PORT=8000
# device_id the mobile app subscribes to (tag location + all events use this)
APP_DEVICE_ID=scooter
# device metadata shown in the app
APP_DEVICE_NAME=cuRiding Scooter
APP_DEVICE_HARDWARE=Raspberry Pi 5 (QNX 8) + ESP32-C3 Find My tag

# Crash detection: heartbeat gap (seconds) and minimum last-known speed
# (km/h) that together raise a crash event
CRASH_GAP_S=30
CRASH_MIN_SPEED_KMH=5

# Find My via macless-haystack. Leave HAYSTACK_URL empty to disable.
# Inside docker compose the endpoint is reachable at the service name.
HAYSTACK_URL=http://macless-haystack:6176
# Basic auth, only if endpoint_user/endpoint_pass are set in the
# macless-haystack config.ini
HAYSTACK_USER=
HAYSTACK_PASS=
# generate_keys.py output (PREFIX.keys) with the tag's private key.
# docker-compose mounts ./secrets to /secrets — put the file there.
HAYSTACK_KEYFILE=/secrets/scooter.keys
# device_id under which tag locations appear in the GPS API
# poll interval (seconds) and how many days of reports to request
HAYSTACK_POLL_S=60
HAYSTACK_DAYS=1
